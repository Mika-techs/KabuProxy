<component name="ProjectRunConfigurationManager">
  <!-- Builds kabuproxy:latest through IntelliJ's Docker plugin (the build-image.sh script needs the docker CLI, which the
       Flatpak sandbox doesn't have). Runs "build" + "docker libs" first, because the image takes the host-built war. -->
  <configuration default="false" name="Docker image" type="docker-deploy" factoryName="dockerfile" server-name="Docker">
    <deployment type="dockerfile">
      <settings>
        <option name="imageTag" value="kabuproxy:latest" />
        <option name="buildOnly" value="true" />
        <option name="contextFolderPath" value="." />
        <option name="sourceFilePath" value="Dockerfile" />
      </settings>
    </deployment>
    <method v="2">
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="build" run_configuration_type="MavenRunConfiguration" />
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="docker libs" run_configuration_type="MavenRunConfiguration" />
    </method>
  </configuration>
</component>
