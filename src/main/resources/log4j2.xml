<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{DEFAULT}{Europe/Berlin} [%t] %-5p (%F:%L) - %m%n" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="de.mik" level="${sys:logger.kabu.level:-INFO}"/>
        <Root level="${sys:logger.root.level:-INFO}">
            <AppenderRef ref="stdout" />
        </Root>
    </Loggers>
</Configuration>
