<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">

    <changeSet id="001-app-user" author="mik">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="oidc_subject" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_app_user_subject"/>
            </column>
            <column name="username" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="last_login_at" type="DATETIME(6)"/>
            <column name="changes_seen_at" type="DATETIME(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="001-school-class" author="mik">
        <createTable tableName="school_class">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_school_class_name"/>
            </column>
            <column name="timetable_updated_at" type="DATETIME(6)"/>
            <column name="calendar_updated_at" type="DATETIME(6)"/>
        </createTable>

        <createTable tableName="period_slot">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_period_slot_class" references="school_class(id)" deleteCascade="true"/>
            </column>
            <column name="period" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="period_slot" columnNames="class_id, period" constraintName="uq_period_slot"/>
    </changeSet>

    <changeSet id="001-digikabu-account" author="mik">
        <createTable tableName="digikabu_account">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_account_user"
                             foreignKeyName="fk_account_user" references="app_user(id)" deleteCascade="true"/>
            </column>
            <column name="digikabu_username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="password_enc" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)"/>
            <column name="class_id" type="BIGINT">
                <constraints foreignKeyName="fk_account_class" references="school_class(id)"/>
            </column>
            <column name="crawl_status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="fail_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="VARCHAR(1000)"/>
            <column name="last_attempt_at" type="DATETIME(6)"/>
            <column name="last_success_at" type="DATETIME(6)"/>
            <column name="next_attempt_at" type="DATETIME(6)"/>
            <column name="absence_full_days" type="INT"/>
            <column name="absence_full_days_unexcused" type="INT"/>
            <column name="absence_hours" type="INT"/>
            <column name="absence_hours_unexcused" type="INT"/>
            <column name="absences_updated_at" type="DATETIME(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="001-lesson" author="mik">
        <createTable tableName="lesson">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_lesson_class" references="school_class(id)" deleteCascade="true"/>
            </column>
            <column name="lesson_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_from" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="period_to" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lane" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lane_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="teacher" type="VARCHAR(100)"/>
            <column name="room" type="VARCHAR(100)"/>
            <column name="subject" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status_raw" type="VARCHAR(50)"/>
            <column name="hint" type="VARCHAR(500)"/>
            <column name="note" type="VARCHAR(1000)"/>
            <column name="digikabu_id" type="VARCHAR(50)"/>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="lesson" indexName="ix_lesson_class_date">
            <column name="class_id"/>
            <column name="lesson_date"/>
        </createIndex>

        <createTable tableName="lesson_change">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_lesson_change_class" references="school_class(id)" deleteCascade="true"/>
            </column>
            <column name="lesson_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_from" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="period_to" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="change_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="before_text" type="VARCHAR(500)"/>
            <column name="after_text" type="VARCHAR(500)"/>
            <column name="detected_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="lesson_change" indexName="ix_lesson_change_class_detected">
            <column name="class_id"/>
            <column name="detected_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-calendar-day" author="mik">
        <createTable tableName="calendar_day">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_calendar_day_class" references="school_class(id)" deleteCascade="true"/>
            </column>
            <column name="day_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="VARCHAR(500)"/>
        </createTable>
        <addUniqueConstraint tableName="calendar_day" columnNames="class_id, day_date" constraintName="uq_calendar_day"/>
    </changeSet>

    <changeSet id="001-absence" author="mik">
        <createTable tableName="absence">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_absence_account" references="digikabu_account(id)" deleteCascade="true"/>
            </column>
            <column name="absence_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="from_text" type="VARCHAR(50)"/>
            <column name="to_text" type="VARCHAR(50)"/>
            <column name="remark" type="VARCHAR(1000)"/>
            <column name="kind" type="VARCHAR(100)"/>
            <column name="excused" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="absence" indexName="ix_absence_account">
            <column name="account_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-crawl-debug" author="mik">
        <createTable tableName="crawl_debug">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints foreignKeyName="fk_crawl_debug_account" references="digikabu_account(id)" deleteCascade="true"/>
            </column>
            <column name="url" type="VARCHAR(500)"/>
            <column name="error" type="VARCHAR(1000)"/>
            <column name="html" type="MEDIUMTEXT"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
