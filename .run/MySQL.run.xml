<component name="ProjectRunConfigurationManager">
  <!-- Local dev DB via IntelliJ's Docker plugin (talks to the rootless socket directly - no docker CLI needed inside the
       Flatpak). Shares the data volume with the compose "localdb" profile, but only one of the two may run (port 3306). -->
  <configuration default="false" name="MySQL" type="docker-deploy" factoryName="docker-image" server-name="Docker">
    <deployment type="docker-image">
      <settings>
        <option name="imageTag" value="mysql:8.4" />
        <option name="containerName" value="kabuproxy-mysql" />
        <option name="envVars">
          <list>
            <DockerEnvVarImpl>
              <option name="name" value="MYSQL_DATABASE" />
              <option name="value" value="kabuproxy" />
            </DockerEnvVarImpl>
            <DockerEnvVarImpl>
              <option name="name" value="MYSQL_USER" />
              <option name="value" value="kabuproxy" />
            </DockerEnvVarImpl>
            <DockerEnvVarImpl>
              <option name="name" value="MYSQL_PASSWORD" />
              <option name="value" value="kabuproxy" />
            </DockerEnvVarImpl>
            <DockerEnvVarImpl>
              <option name="name" value="MYSQL_RANDOM_ROOT_PASSWORD" />
              <option name="value" value="yes" />
            </DockerEnvVarImpl>
            <DockerEnvVarImpl>
              <option name="name" value="TZ" />
              <option name="value" value="Europe/Berlin" />
            </DockerEnvVarImpl>
          </list>
        </option>
        <option name="portBindings">
          <list>
            <DockerPortBindingImpl>
              <option name="containerPort" value="3306" />
              <option name="hostIp" value="127.0.0.1" />
              <option name="hostPort" value="3306" />
            </DockerPortBindingImpl>
          </list>
        </option>
        <option name="volumeBindings">
          <list>
            <DockerVolumeBindingImpl>
              <option name="containerPath" value="/var/lib/mysql" />
              <option name="hostPath" value="kabuproxy_kabuproxy-mysql" />
            </DockerVolumeBindingImpl>
          </list>
        </option>
      </settings>
    </deployment>
    <method v="2" />
  </configuration>
</component>
